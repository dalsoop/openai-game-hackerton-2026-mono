{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "party-usemap.geometry.schema.json",
  "title": "Prototype geometry contract",
  "type": "object",
  "required": [
    "schemaVersion",
    "coordinateSystem"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "coordinateSystem": {
      "type": "object",
      "required": [
        "origin",
        "xPositive",
        "yPositive",
        "units"
      ],
      "properties": {
        "origin": {
          "const": "top-left"
        },
        "xPositive": {
          "const": "right"
        },
        "yPositive": {
          "const": "down"
        },
        "units": {
          "const": "world-unit"
        }
      }
    }
  }
}
