#!/bin/sh
# 커밋 게이트 — 1) GD 린트(정규식) 2) Godot 파스+유닛(런타임).
# 훅 활성화(1회): git config core.hooksPath .githooks
set -e

# GDScript 가 스테이지에 있을 때만 GD 게이트 (속도 가드)
if git diff --cached --name-only | grep -q "\.gd$"; then
  echo "▶ GD 게이트: lint_gd"
  python3 lint_gd.py apps/dagul-prod/project --baseline lint_gd_baseline.json

  echo "▶ GD 게이트: 스테이지 파일 파스 (고아 파일 포함)"
  GODOT="${GODOT_BIN:-/Applications/Godot.app/Contents/MacOS/Godot}"
  for f in $(git diff --cached --name-only | grep "\.gd$"); do
    # 저장소 루트 기준 res:// 경로로 변환 (dagul-prod 하위만 — 그 외 슬롯은 건너뛴다)
    REL="${f#apps/dagul-prod/project/}"
    [ "$REL" = "$f" ] && continue
    OUT=$("$GODOT" --headless --path apps/dagul-prod/project --check-only --script "res://$REL" 2>&1 || true)
    echo "$OUT" | grep -E "Parse Error|SCRIPT ERROR" && {
      echo "❌ pre-commit: 파스 실패 — $f"
      exit 1
    }
  done

  echo "▶ GD 게이트: Godot 파스+유닛테스트"
  TEST_LOG=$("$GODOT" --headless --path apps/dagul-prod/project --script res://tests/run_tests.gd 2>&1 || true)
  echo "$TEST_LOG" | grep -E "GDTEST FAIL|SCRIPT ERROR|Parse Error" && {
    echo "❌ pre-commit: GDScript 파스/테스트 실패"
    exit 1
  }
  echo "$TEST_LOG" | grep "GDTEST SUMMARY" || {
    echo "❌ pre-commit: GD 테스트 러너 미기동 (Godot/경로 확인)"
    exit 1
  }
fi

echo "▶ 배포 계약: test_ship_contracts"
python3 deploy/scripts/test_ship_contracts.py

echo "▶ 차트 스케일 계약: test_hub_scale"
python3 deploy/scripts/test_hub_scale.py

# 웹 게이트 — 스테이지된 트리만 본다. 워킹트리 미스테이지가 tsc를 통과시키면 안 된다.
# stash --keep-index 만 ( -u 금지: untracked 를 삼키지 않는다). 경로는 web 로 한정.
if git diff --cached --name-only | grep -qE "^apps/dagul-prod/web/.*\.(ts|tsx|mjs|json)$"; then
  echo "▶ WEB 게이트: staged tree tsc + eslint + vitest"
  WEB_STASHED=0
  if ! git diff --quiet -- apps/dagul-prod/web; then
    git stash push --keep-index --quiet -m "pre-commit-web-gate" -- apps/dagul-prod/web
    WEB_STASHED=1
  fi
  set +e
  (cd apps/dagul-prod/web \
    && npx tsc --noEmit \
    && npx eslint . \
    && npx vitest run --reporter=dot 2>&1 | tail -3)
  WEB_STATUS=$?
  set -e
  if [ "$WEB_STASHED" = 1 ]; then
    if ! git stash pop --quiet; then
      echo "⚠ pre-commit: stash pop 실패 — 게이트는 통과, 워킹트리만 확인하세요"
    fi
  fi
  if [ "$WEB_STATUS" -ne 0 ]; then
    echo "❌ pre-commit: 웹 게이트 실패 — 스테이지된 트리를 고친 뒤 다시 커밋"
    exit 1
  fi
fi
