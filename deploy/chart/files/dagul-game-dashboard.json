{
  "uid": "dagul-game",
  "title": "다굴즈 서버 운영",
  "tags": [
    "dagul",
    "ccu",
    "hackertone"
  ],
  "timezone": "Asia/Seoul",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "데이터소스"
      },
      {
        "name": "slot",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(dagul_ccu, slot)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "dagul-prod",
          "value": "dagul-prod"
        },
        "label": "슬롯"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "서버 정원",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dagul_ccu{slot=\"$slot\"}"
        },
        {
          "refId": "B",
          "expr": "dagul_ccu_cap{slot=\"$slot\"}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "입장",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dagul_ccu_admit{slot=\"$slot\"}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "가능",
                  "color": "green"
                },
                "0": {
                  "text": "꽉참",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "정원 사용률",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dagul_ccu{slot=\"$slot\"} / dagul_ccu_cap{slot=\"$slot\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "orange",
                "value": 0.75
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "동접과 서버 정원",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dagul_ccu{slot=\"$slot\"}",
          "legendFormat": "동접"
        },
        {
          "refId": "B",
          "expr": "dagul_ccu_cap{slot=\"$slot\"}",
          "legendFormat": "서버 정원"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "방 수 — 전체·플레이 중·대기",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dagul_rooms_total{slot=\"$slot\"}",
          "legendFormat": "전체"
        },
        {
          "refId": "B",
          "expr": "dagul_rooms_playing{slot=\"$slot\"}",
          "legendFormat": "플레이 중"
        },
        {
          "refId": "C",
          "expr": "dagul_rooms_waiting{slot=\"$slot\"}",
          "legendFormat": "대기"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "자리한 플레이어 수",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dagul_players_total{slot=\"$slot\"}",
          "legendFormat": "전체"
        },
        {
          "refId": "B",
          "expr": "dagul_players_playing{slot=\"$slot\"}",
          "legendFormat": "플레이 중"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "게임별 방 수",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dagul_rooms_by_game{slot=\"$slot\"}",
          "legendFormat": "{{game}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "id": 100,
      "type": "row",
      "title": "서비스 — 플레이어 경험",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 101,
      "type": "stat",
      "title": "오늘 DAU",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 31 },
      "targets": [
        { "refId": "A", "expr": "dagul_dau{slot=\"$slot\"}" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 102,
      "type": "stat",
      "title": "게임 시작",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 31 },
      "targets": [
        { "refId": "A", "expr": "increase(dagul_games_started_total{slot=\"$slot\"}[1h])" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 103,
      "type": "stat",
      "title": "게임 완료",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 31 },
      "targets": [
        { "refId": "A", "expr": "increase(dagul_games_finished_total{slot=\"$slot\"}[1h])" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 104,
      "type": "stat",
      "title": "게임 완료율",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 31 },
      "targets": [
        { "refId": "A", "expr": "increase(dagul_games_finished_total{slot=\"$slot\"}[1h]) / clamp_min(increase(dagul_games_started_total{slot=\"$slot\"}[1h]), 1)" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 0, "min": 0, "max": 1 }, "overrides": [] }
    },
    {
      "id": 105,
      "type": "timeseries",
      "title": "평균 세션 길이",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "targets": [
        { "refId": "A", "expr": "rate(dagul_session_duration_seconds_sum{slot=\"$slot\"}[5m]) / clamp_min(rate(dagul_session_duration_seconds_count{slot=\"$slot\"}[5m]), 0.001)", "legendFormat": "평균 세션 (초)" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true } }, "overrides": [] }
    },
    {
      "id": 106,
      "type": "timeseries",
      "title": "평균 매치 대기 시간",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "targets": [
        { "refId": "A", "expr": "rate(dagul_match_wait_seconds_sum{slot=\"$slot\"}[5m]) / clamp_min(rate(dagul_match_wait_seconds_count{slot=\"$slot\"}[5m]), 0.001)", "legendFormat": "평균 대기 (초)" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true } }, "overrides": [] }
    },
    {
      "id": 107,
      "type": "timeseries",
      "title": "WS 접속·이탈·에러",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 43 },
      "targets": [
        { "refId": "A", "expr": "rate(dagul_ws_connections_total{slot=\"$slot\"}[5m]) * 60", "legendFormat": "접속/분" },
        { "refId": "B", "expr": "rate(dagul_ws_disconnects_total{slot=\"$slot\"}[5m]) * 60", "legendFormat": "이탈/분" },
        { "refId": "C", "expr": "rate(dagul_ws_errors_total{slot=\"$slot\"}[5m]) * 60", "legendFormat": "에러/분" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true } }, "overrides": [] }
    },
    {
      "id": 108,
      "type": "timeseries",
      "title": "킥·매치 실패",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 43 },
      "targets": [
        { "refId": "A", "expr": "increase(dagul_player_kicks_total{slot=\"$slot\"}[1h])", "legendFormat": "킥" },
        { "refId": "B", "expr": "increase(dagul_match_failures_total{slot=\"$slot\"}[1h])", "legendFormat": "입장 실패" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true } }, "overrides": [] }
    },
    {
      "id": 109,
      "type": "timeseries",
      "title": "평균 에셋 로딩 시간",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 51 },
      "targets": [
        { "refId": "A", "expr": "rate(dagul_asset_load_seconds_sum{slot=\"$slot\"}[5m]) / clamp_min(rate(dagul_asset_load_seconds_count{slot=\"$slot\"}[5m]), 0.001)", "legendFormat": "평균 로딩 (초)" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true } }, "overrides": [] }
    },
    {
      "id": 200,
      "type": "row",
      "title": "운영 — 서버 성능",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 59 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 201,
      "type": "timeseries",
      "title": "틱 처리 시간 (평균·최대)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 52 },
      "targets": [
        { "refId": "A", "expr": "rate(dagul_tick_duration_ms_sum{slot=\"$slot\"}[1m]) / clamp_min(rate(dagul_tick_duration_ms_count{slot=\"$slot\"}[1m]), 0.001)", "legendFormat": "평균 (ms)" },
        { "refId": "B", "expr": "dagul_tick_duration_ms_max{slot=\"$slot\"}", "legendFormat": "최대 (ms)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 10 },
            { "color": "red", "value": 16.7 }
          ]}
        },
        "overrides": []
      }
    },
    {
      "id": 202,
      "type": "timeseries",
      "title": "틱 초과 횟수",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 52 },
      "targets": [
        { "refId": "A", "expr": "rate(dagul_tick_overruns_total{slot=\"$slot\"}[5m]) * 60", "legendFormat": "초과/분" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true } }, "overrides": [] }
    },
    {
      "id": 203,
      "type": "timeseries",
      "title": "WS 송신 큐 깊이",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 60 },
      "targets": [
        { "refId": "A", "expr": "dagul_ws_send_queue_length{slot=\"$slot\"}", "legendFormat": "큐 깊이" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 50 },
            { "color": "red", "value": 200 }
          ]}
        },
        "overrides": []
      }
    },
    {
      "id": 204,
      "type": "timeseries",
      "title": "Pod 재시작",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 60 },
      "targets": [
        { "refId": "A", "expr": "increase(kube_pod_container_status_restarts_total{namespace=~\"hackertone.*\", container=\"hub\"}[1h])", "legendFormat": "{{pod}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 50 } }, "overrides": [] }
    },
    {
      "id": 205,
      "type": "timeseries",
      "title": "TLS 인증서 만료까지 남은 시간",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 68 },
      "targets": [
        { "refId": "A", "expr": "(certmanager_certificate_expiration_timestamp_seconds{namespace=~\"hackertone.*\"} - time()) / 86400", "legendFormat": "{{name}} (일)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 7 },
            { "color": "green", "value": 14 }
          ]}
        },
        "overrides": []
      }
    },
    {
      "id": 206,
      "type": "timeseries",
      "title": "평균 라운드 시간",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 68 },
      "targets": [
        { "refId": "A", "expr": "rate(dagul_round_duration_seconds_sum{slot=\"$slot\"}[5m]) / clamp_min(rate(dagul_round_duration_seconds_count{slot=\"$slot\"}[5m]), 0.001)", "legendFormat": "평균 라운드 (초)" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true } }, "overrides": [] }
    }
  ]
}
